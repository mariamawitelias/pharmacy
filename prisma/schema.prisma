  // ⚠️ TEMPORARY INVERSE RELATIONS — Person 3 (Q&A/Notifications) needs these.
  // Person 1: please preserve or migrate when you finalize the User model.
  questionsAsPatient   Question[] @relation("PatientQuestions")
  questionsAsClaimedBy Question[] @relation("ClaimedQuestions")
