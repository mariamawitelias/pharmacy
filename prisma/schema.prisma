// =============================================================
// === Person 3 — Q&A, Notifications ===========================
// =============================================================

enum QuestionStatus {
  OPEN
  CLAIMED
  ANSWERED
  CLOSED
}

model Question {
  id             Int            @id @default(autoincrement())
  patientId      Int
  medicineId     Int?
  prescriptionId Int?
  text           String
  status         QuestionStatus @default(OPEN)
  claimedById    Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient   User     @relation("PatientQuestions", fields: [patientId], references: [id])
  claimedBy User?    @relation("ClaimedQuestions", fields: [claimedById], references: [id])
  medicine  Medicine? @relation(fields: [medicineId], references: [id])
  // TODO(Person 1): add prescription relation when Prescription model exists
  // prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  answer    Answer?
}

model Answer {
  id           Int      @id @default(autoincrement())
  questionId   Int      @unique
  pharmacistId Int
  text         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  pharmacist User     @relation("PharmacistAnswers", fields: [pharmacistId], references: [id])
}

enum NotificationType {
  QUESTION_ANSWERED
  PRESCRIPTION_UPDATED
  ORDER_UPDATED
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int
  type      NotificationType
  message   String
  data      Json?
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
