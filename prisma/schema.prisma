// ⚠️ TEMPORARY PLACEHOLDER — owned by Person 1, will be REPLACED by their real models.
// Do NOT build additional features on these fields — confirm with Person 1 first.
// (Present only so Person 3's Question.medicineId FK and seed script can validate.)
model Pharmacy {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO(Person 1): operating hours, verification status, inventory relation
}

// ⚠️ TEMPORARY PLACEHOLDER — owned by Person 1, will be REPLACED by their real models.
// Do NOT build additional features on these fields — confirm with Person 1 first.
// (Present only so Person 3's Question.medicineId FK and seed script can validate.)
model Medicine {
  id                  Int      @id @default(autoincrement())
  name                String
  genericName         String?
  form                String?
  prescriptionRequired Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // TODO(Person 1): inventory relation

  // ⚠️ TEMPORARY INVERSE RELATION — Person 3 (Q&A) needs this.
  // Person 1: please preserve or migrate when you finalize the Medicine model.
  questionsAsMedicine Question[]
}

