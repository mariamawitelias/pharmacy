// =============================================================
// Medireach Prisma Schema
// =============================================================
// Person 1: Auth, Users, Pharmacies, Medicines, Inventory, Geolocation
// Person 2: Prescriptions, Orders, Delivery
// Person 3: Q&A, Notifications, Accessibility
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

