// TODO(Person 1): Implement these models fully
// =============================================================

enum Role {
  PATIENT
  DOCTOR
  PHARMACIST
  RIDER
  ADMIN
}

// ⚠️ TEMPORARY PLACEHOLDER — owned by Person 1, will be REPLACED by their real models.
// Do NOT build additional features on these fields — confirm with Person 1 first.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO(Person 1): Add Patient/Doctor/Pharmacist/Rider profile relations
  // TODO(Person 1): Add caregiver/family link support

  // ⚠️ TEMPORARY INVERSE RELATIONS — Person 3 (Q&A/Notifications) needs these.
  // Person 1: please preserve or migrate when you finalize the User model.
  questionsAsPatient   Question[] @relation("PatientQuestions")
  questionsAsClaimedBy Question[] @relation("ClaimedQuestions")
  answersAsPharmacist  Answer[]   @relation("PharmacistAnswers")
  notifications        Notification[]
}

// TODO(Person 1): model Patient { ... extends User? or one-to-one? }
